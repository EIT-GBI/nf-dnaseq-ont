// The shape of assets/samplesheet_template.csv: id,sample,reads,reference,
// where `sample` is the human-readable name and fai falls back to <fasta>.fai.
includeConfig 'test.config'

params {
    samplesheet = "${projectDir}/assets/test/samplesheet_template_schema.csv"
    outdir      = 'results-test-template'

    methylation.enabled      = false
    methylation.motif_search = false
}

// see conf/test_barcodes.config
outputDir = params.outdir
