// Real-tool run for the pipeline regression test: default params, except for
// the two settings that would pull the dorado image. dorado's aligner and trim
// are CPU-capable, but the image is CUDA-based and linux/amd64 only, so this
// routes alignment through minimap2 instead. The dorado path stays covered by
// the stub test.
docker.enabled    = true
// --platform: the modkit image is linux/amd64 only, so an arm64 Mac needs
// emulation. A no-op on the x86 runners CI uses.
docker.runOptions = '-u $(id -u):$(id -g) --platform=linux/amd64'

params {
    alignment.tool = 'minimap2'
    trim.enabled   = false
}
