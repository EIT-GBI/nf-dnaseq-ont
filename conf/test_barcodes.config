// One sample (SAMPLE1) across two barcodes. The sheet is also an older
// three-column one, so this covers the back-compatible mapping too.
includeConfig 'test.config'

params {
    samplesheet = "${params.testdata_base_path}/data/samplesheets/ont/multiple_barcodes_per_sample.csv"
    outdir      = 'results-test-barcodes'

    methylation.enabled      = false
    methylation.motif_search = false
}

// nextflow.config's `outputDir = params.outdir` resolves while the `test`
// profile is in effect, before these params merge in, so repeat it here.
outputDir = params.outdir
