// The id,name,ont_r,fasta,fai schema: one sheet mixing a two-barcode sample
// with a single-barcode one, with fai named explicitly. Kept in-repo because
// generate-test-seq-data still ships the older three-column sheets.
includeConfig 'test.config'

params {
    samplesheet = "${projectDir}/assets/test/samplesheet_new_schema.csv"
    outdir      = 'results-test-new-schema'

    methylation.enabled      = false
    methylation.motif_search = false
}

// see conf/test_barcodes.config
outputDir = params.outdir
