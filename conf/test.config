// Minimal test profile — overrides params with small inputs for CI / smoke runs.

params {
    testdata_base_path = 'https://raw.githubusercontent.com/EIT-GBI/generate-test-seq-data/v1.0.0'

    samplesheet = "${params.testdata_base_path}/data/samplesheets/ont/two_samples.csv"
    reference_dir = "${params.testdata_base_path}/data/references/"
    outdir = 'results-test'

    trim.enabled = true
    filter.enabled = true
    consensus.enabled = true
    methylation.enabled = true
    methylation.motif_search = true

}
