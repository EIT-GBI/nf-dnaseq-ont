// Defaults for every parameter. A -params-file overrides these; the command
// line overrides both.
params {
    samplesheet              = null
    reads_dir                = null
    reference_genome         = null
    reference_dir            = null
    outdir                   = 'results'

    basecalling.redo           = false
    basecalling.model          = '/opt/models/dna_r10.4.1_e8.2_400bps_sup@v5.0.0'
    basecalling.modified_bases = ''

    alignment.device = 'gpu'
    alignment.tool   = 'dorado'

    trim.enabled = false

    filter.enabled          = false
    filter.min_read_length  = 1000
    filter.min_read_quality = 10

    methylation.enabled      = false
    methylation.motif_search = false

    consensus.enabled   = false
    consensus.min_depth = 10     // positions below this become N
    consensus.min_mapq  = 20     // ignore poorly-mapped reads

    ucsc_dir = null
}

profiles {
    cluster {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        apptainer.cacheDir   = '/mnt/lustre/containers/.staging/nf/cache'
        apptainer.runOptions = '-B /mnt/instrument-data'
        docker.enabled       = false
        process.executor     = 'slurm'
        process.queue        = 'cpu'
        process {
            withName: 'DORADO_BASECALLER' {
                cpus             = 8
                memory           = '96 GB'
                accelerator      = 1
                clusterOptions   = '--gres=gpu:1'   // keep count == accelerator/--num-gpus
                queue            = 'gpu'
                containerOptions = '--nv'
                errorStrategy    = 'retry'
                maxRetries       = 2
                time             = '48 h'
            }
            withName: 'DORADO_ALIGNER' {
                queue            = 'gpu'
                clusterOptions   = '--gres=gpu:1'
                containerOptions = '--nv'
                memory = '48GB'
            }
            withName: 'DORADO_TRIM' {
                queue            = 'gpu'
                clusterOptions   = '--gres=gpu:1'
                containerOptions = '--nv'
                memory = '48GB'
            }

            withName: 'MODKIT.*' { cpus = 8;  memory = '32 GB'; time = '12 h' }

            withName: 'SAMTOOLS_(FILTER|FLAGSTAT)' { cpus = 4;  memory = '16 GB' }
            withName: 'SAMTOOLS_CONSENSUS' { cpus = 8;  memory = '16 GB'; time = '12 h' }
            withName: 'NANOPLOT_NANOPLOT' { cpus = 4;  memory = '16 GB' }   
        }
    }
}


process {
    errorStrategy = 'finish'
    withName: 'SAMTOOLS.*' {
        container = 'ghcr.io/eit-gbi/nf-mod-samtools:latest'
        ext.args  = ''
        cpus      = 4
    }
    withName: 'DORADO.*' {
        container = 'ghcr.io/eit-gbi/nf-mod-dorado:latest'
        ext.args  = ''
        cpus      = 4
    }
    withName: 'NANOPLOT.*' {
        container = 'ghcr.io/eit-gbi/nf-mod-nanoplot:latest'
        ext.args  = ''
        cpus      = 4
    }
    withName: 'MODKIT.*' {
        container = 'ghcr.io/eit-gbi/nf-mod-modkit:latest'
        ext.args  = ''
        cpus      = 4
    }
    // As of nf-mod-samtools v1.0.0 the modules carry no publishDir and build no
    // arguments of their own -- both are the consuming pipeline's job. These
    // selectors are declared after 'SAMTOOLS.*' so they override its ext.args.
    withName: 'SAMTOOLS_FILTER' {
        // without this the filter is a no-op that copies the BAM unchanged
        ext.args   = "-e 'avg(qual) >= ${params.filter.min_read_quality} && length(seq) >= ${params.filter.min_read_length}'"
        publishDir = [ path: "${params.outdir}/filtered", mode: 'copy' ]
    }
    withName: 'SAMTOOLS_FLAGSTAT' {
        publishDir = [ path: "${params.outdir}/qc/flagstat", mode: 'link' ]
    }
    withName: 'SAMTOOLS_CONSENSUS' {
        // -a emits every reference position, so sub-threshold coverage becomes N
        ext.args   = "-a --min-depth ${params.consensus.min_depth} --min-MQ ${params.consensus.min_mapq}"
        publishDir = [ path: "${params.outdir}/consensus", mode: 'copy' ]
    }
}