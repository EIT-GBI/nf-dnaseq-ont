
params {
    //Inputs
    samplesheet = null
    reads_dir = null
    reference_genome = null
    outdir = 'results'



}

// Base directory for the workflow `output {}` block.
// Override on the CLI with `-output-dir <path>` or via `--outdir <path>`.
outputDir = params.outdir





profiles {
    docker {
        docker.enabled = true
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    test {
        includeConfig 'conf/test.config'
    }
}
