// Defaults for every parameter. A -params-file overrides these; the command
// line overrides both.
params {
    samplesheet              = null
    reference_dir            = null
    outdir                   = 'results'

    basecalling.redo           = false
    basecalling.model          = '/opt/models/dna_r10.4.1_e8.2_400bps_sup@v5.0.0'
    basecalling.modified_bases = ''

    alignment.tool = 'dorado'

    trim.enabled = false

    filter.enabled          = false
    filter.min_read_length  = 1000
    filter.min_read_quality = 10

    methylation.enabled      = false
    methylation.motif_search = false

    consensus.enabled   = false
    consensus.min_depth = 10     // positions below this become N
    consensus.min_mapq  = 20     // ignore poorly-mapped reads

    bigwig.enabled = true      // coverage track, built after the barcode merge

    ucsc_dir = null
}

profiles {
    test {
        includeConfig 'conf/test.config'
    }
    cluster {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        apptainer.cacheDir   = '/mnt/lustre/containers/.staging/nf/cache'
        apptainer.runOptions = '-B /mnt/instrument-data'
        docker.enabled       = false
        process.executor     = 'slurm'
        process.queue        = 'cpu'
        process {
            withName: 'DORADO_BASECALLER' {
                cpus             = 8
                memory           = '96 GB'
                accelerator      = 1
                clusterOptions   = '--gres=gpu:1'   // keep count == accelerator/--num-gpus
                queue            = 'gpu'
                containerOptions = '--nv'
                errorStrategy    = 'retry'
                maxRetries       = 2
                time             = '48 h'
            }
            withName: 'DORADO_ALIGNER' {
                queue            = 'gpu'
                clusterOptions   = '--gres=gpu:1'
                containerOptions = '--nv'
                memory = '48GB'
            }
            withName: 'DORADO_TRIM' {
                queue            = 'gpu'
                clusterOptions   = '--gres=gpu:1'
                containerOptions = '--nv'
                memory = '48GB'
            }

            withName: 'MODKIT.*' { cpus = 8;  memory = '32 GB'; time = '12 h' }

            withName: 'SAMTOOLS_(FILTER|FLAGSTAT)' { cpus = 4;  memory = '16 GB' }
            withName: 'SAMTOOLS_CONSENSUS' { cpus = 8;  memory = '16 GB'; time = '24 h' }
            withName: 'BEDTOOLS_BIGWIG' { cpus = 4;  memory = '8 GB'; time = '4 h' }
            withName: 'NANOPLOT_NANOPLOT' { cpus = 4;  memory = '16 GB' }   
        }
    }
}


process {
    errorStrategy = 'finish'
    withName: 'SAMTOOLS.*' {
        container = 'ghcr.io/eit-gbi/nf-mod-samtools:v1.2.0'
        ext.args  = ''
        cpus      = 4
    }
    withName: 'DORADO.*' {
        container = 'ghcr.io/eit-gbi/nf-mod-dorado:v1.0.0'
        ext.args  = ''
        cpus      = 4
    }
    withName: 'NANOPLOT.*' {
        container = 'ghcr.io/eit-gbi/nf-mod-nanoplot:v2.0.0'
        ext.args  = ''
        cpus      = 4
    }
    withName: 'MODKIT.*' {
        container = 'ghcr.io/eit-gbi/nf-mod-modkit:v1.1.0'
        ext.args  = ''
        cpus      = 4
    }
    withName: 'BEDTOOLS.*' {
        container = 'ghcr.io/eit-gbi/nf-mod-bedtools:v1.0.1'
        ext.args  = ''
        cpus      = 4
        // container-less local runs only; the image bakes in bedGraphToBigWig
        beforeScript = { params.ucsc_dir ? "export PATH=${params.ucsc_dir}:\$PATH" : '' }
    }
    withName: 'MINIMAP2.*' {
        container = 'ghcr.io/eit-gbi/nf-mod-minimap2:v1.0.0'
        // -y carries the MM/ML tags from the FASTQ comment into the BAM
        ext.args   = '-y'
        cpus       = 4
    }
    // The nf-mod-* modules carry no publishDir and build no arguments of their
    // own -- publishing lives in main.nf's output{} block, and these selectors
    // are declared after 'SAMTOOLS.*' so they override its ext.args.
    withName: 'SAMTOOLS_FILTER' {
        // without this the filter is a no-op that copies the BAM unchanged
        ext.args   = "-e 'avg(qual) >= ${params.filter.min_read_quality} && length(seq) >= ${params.filter.min_read_length}'"
    }
    withName: 'SAMTOOLS_FASTQ' {
        // without -T the modified-base tags are dropped on the way out of the uBAM
        ext.args = '-T MM,ML'
    }
    withName: 'SAMTOOLS_CONSENSUS' {
        // -a emits every reference position, so sub-threshold coverage becomes N
        ext.args   = "-a --min-depth ${params.consensus.min_depth} --min-MQ ${params.consensus.min_mapq}"
    }
}

// Nextflow does not wire params.outdir to the output directory automatically,
// and main.nf's output{} block publishes relative to outputDir. A -params-file
// may override params.outdir, and this assignment reads whatever value is
// in effect.
outputDir = params.outdir
